# Copy to .env for LOCAL runs only. NEVER commit .env. In GitHub use Settings > Secrets.
NEON_HOST=ep-xxxx.eu-central-1.aws.neon.tech
NEON_DB=neondb
NEON_USER=neondb_owner
NEON_PASSWORD=change-me

# Airbyte Cloud (Settings > Applications)
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_SHEETS_CONNECTION_ID=
AIRBYTE_EXCHANGE_RATE_CONNECTION_ID=

# Only for the Python fallback (INGESTION_MODE=python)
GOOGLE_SERVICE_ACCOUNT_JSON=
TRADE_LOG_SHEET_ID=
